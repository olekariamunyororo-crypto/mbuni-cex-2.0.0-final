# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log

# Database (SQLite dev file — runtime data, not source)
/db/
*.db
*.db-journal

# Skills directory
/skills/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Prisma migrations local state
/prisma/migrations/dev.db*

# Helm secrets overlays (kept out of git — use --set or ExternalSecrets)
infra/k8s/secrets.yaml
infra/k8s/sealed-secret.yaml

# Test artifacts (don't commit — generated by CI)
/coverage/
/test-results/
/playwright-report/
/playwright/.cache/

# Storybook build output (don't commit — generated on demand)
/storybook-static/

# Playwright visual regression baselines ARE committed (so diffs are caught in PRs)
# — but the .cache dir above is not.